{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taptap",
  "version": "2.1.0",
  "identifier": "com.taptap.companion",
  "build": {
    "beforeDevCommand": "node scripts/prepare-ui.js",
    "beforeBuildCommand": "node scripts/prepare-ui.js",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../assets/icon.ico",
      "../assets/icon.png"
    ]
  }
}
